# PHPStan at the highest level, as glitchr-studio/ci's workflow runs it. phpstan-baseline.neon lists
# what is accepted; the CI fails on anything else.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
    reportUnmatchedIgnoredErrors: false
